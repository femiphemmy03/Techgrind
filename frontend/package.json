{
  "name": "techgrind-frontend",
  "version": "1.0.0",
  "description": "TECHGRIND LMS — frontend (Vite + React, PWA)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND -c yellow,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "npm --prefix ../backend run dev",
    "build": "vite build",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "axios": "^1.7.7",
    "lucide-react": "^0.446.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "concurrently": "^9.0.1",
    "tailwindcss": "^3.4.13",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "sharp": "^0.33.5"
  }
}
